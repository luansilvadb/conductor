{
  "name": "@luansilvadb/conductor",
  "version": "0.1.0",
  "description": "Conductor - Spec Driven Development CLI",
  "type": "module",
  "bin": {
    "conductor": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
