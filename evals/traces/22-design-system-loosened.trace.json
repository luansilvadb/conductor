    { "t": "gate", "task": "T1", "kind": "design_tokens", "cmd": "node conductor/gates/design-tokens-gate.mjs --src src", "exit_code": 0 },
    { "t": "return", "id": "s1", "protocol": "sdp-v1", "status": "done", "lines": 12, "token_estimate": 1520 }
