{
  "id": "gate-result-carried-over",
  "skill": "conductor-implement",
  "description": "The task closes on a test result from the previous task's run and never declares the absent coverage gate. Both make an unverified check read as a passed one.",
  "expect_failures": ["gate-exit-contract"],
  "gates": [
    { "kind": "test", "cmd": "npm test", "required": true },
    { "kind": "lint", "cmd": "npm run lint", "required": true },
    { "kind": "coverage", "cmd": null, "required": false }
  ],
  "events": [
    { "t": "skill", "name": "conductor-implement" },
    { "t": "wave", "op": "open", "n": 1, "tasks": [{ "id": "T1", "files": ["src/api/routes.ts"], "depends_on": [] }] },
    { "t": "plan", "task": "T1", "status": "[~]" },
    { "t": "dispatch", "id": "s1", "subagent": "general-purpose", "task": "T1", "prompt": "implement T1; return only the JSON schema, no conversational text" },
    { "t": "write", "actor": "sub:s1", "task": "T1", "kind": "test", "path": "src/api/routes.test.ts" },
    { "t": "gate", "task": "T1", "kind": "test", "cmd": "npm test", "exit_code": 1 },
    { "t": "write", "actor": "sub:s1", "task": "T1", "kind": "impl", "path": "src/api/routes.ts" },
    { "t": "gate", "task": "T1", "kind": "test", "cmd": "npm test", "exit_code": 0, "carried_over": true },
    { "t": "gate", "task": "T1", "kind": "lint", "cmd": "npm run lint", "exit_code": 0 },
    { "t": "return", "id": "s1", "protocol": "sdp-v1", "status": "done", "lines": 8, "token_estimate": 1180 },
    { "t": "commit", "actor": "orchestrator", "sha": "3c4d5e6", "message": "feat(api): add routes" },
    { "t": "note", "actor": "orchestrator", "sha": "3c4d5e6" },
    { "t": "plan", "task": "T1", "status": "[x]", "sha": "3c4d5e6" },
    { "t": "commit", "actor": "orchestrator", "sha": "4d5e6f7", "message": "conductor(plan): mark T1 as complete" }
  ]
}
